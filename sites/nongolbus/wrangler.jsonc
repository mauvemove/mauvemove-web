// Cloudflare Workers 정적 자산 배포 설정 (nongolbus.mauvemove.com)
// name 은 Cloudflare 대시보드의 Worker 이름과 같아야 한다.
{
  "name": "nongolbus",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "."
  },
  "routes": [
    { "pattern": "nongolbus.mauvemove.com", "custom_domain": true }
  ],
  // 프로덕션 분기가 아닌 브랜치는 `npx wrangler preview` 로 빌드되며, 이 블록이 있어야 한다.
  "previews": {}
}
